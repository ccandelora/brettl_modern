<footer class="bg-gray-900 text-white">
  <div class="container mx-auto px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      
      <!-- Organization Info -->
      <div class="space-y-4">
        <div class="flex items-center">
          <%= image_tag "brettllogo.png", alt: "Brettl-Hupfers Ski Club", class: "h-12 w-12 mr-3" %>
          <div>
            <h3 class="text-lg font-bold">Brettl-Hupfers</h3>
            <p class="text-sm text-gray-300">Ski Club</p>
          </div>
        </div>
        <p class="text-sm text-gray-300 leading-relaxed">
          A premier ski club dedicated to providing exceptional mountain experiences and fostering a community of ski enthusiasts since our founding.
        </p>
        <div class="flex space-x-4">
          <a href="https://www.facebook.com/brettl.hupfers" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white transition-colors" aria-label="Facebook">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
          <a href="https://www.instagram.com/brettl.hupfers/" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white transition-colors" aria-label="Instagram">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" d="M7.5 2A5.5 5.5 0 0 0 2 7.5v9A5.5 5.5 0 0 0 7.5 22h9a5.5 5.5 0 0 0 5.5-5.5v-9A5.5 5.5 0 0 0 16.5 2h-9ZM4 7.5A3.5 3.5 0 0 1 7.5 4h9A3.5 3.5 0 0 1 20 7.5v9a3.5 3.5 0 0 1-3.5 3.5h-9A3.5 3.5 0 0 1 4 16.5v-9ZM12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0 2a3 3 0 1 1 0 6 3 3 0 0 1 0-6Zm5.75-2.875a1.125 1.125 0 1 0 0 2.25 1.125 1.125 0 0 0 0-2.25Z" clip-rule="evenodd"/>
            </svg>
          </a>
          <a href="https://www.meetup.com/brettl-hupfers-ski-sports-club-meetup-group/" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white transition-colors" aria-label="Meetup">
            <i class="fa-brands fa-meetup text-xl" aria-hidden="true"></i>
          </a>
          <%= link_to contact_path, class: "text-gray-400 hover:text-white transition-colors", aria: { label: "Contact us" } do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
          <% end %>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="space-y-4">
        <h4 class="text-lg font-semibold">Quick Links</h4>
        <nav class="space-y-2">
          <%= link_to "Home", root_path, class: "block text-sm text-gray-300 hover:text-white transition-colors" %>
          <%= link_to "Membership Info", membership_path, class: "block text-sm text-gray-300 hover:text-white transition-colors" %>
          <%= link_to "Guest FAQ", guest_faq_path, class: "block text-sm text-gray-300 hover:text-white transition-colors" %>
          <%= link_to "AT Week Info", at_week_path, class: "block text-sm text-gray-300 hover:text-white transition-colors" %>
          <%= link_to "Volleyball", volleyball_path, class: "block text-sm text-gray-300 hover:text-white transition-colors" %>
          <%= link_to "Payment Information", payment_path, class: "block text-sm text-gray-300 hover:text-white transition-colors" %>
          <%= link_to "Contact", contact_path, class: "block text-sm text-gray-300 hover:text-white transition-colors" %>
        </nav>
      </div>

      <!-- Member Resources -->
      <% if user_signed_in? %>
        <div class="space-y-4">
          <h4 class="text-lg font-semibold">Member Resources</h4>
          <nav class="space-y-2">
            <%= link_to "Current Week", app_reservation_week_path, class: "block text-sm text-gray-300 hover:text-white transition-colors" %>
            <%= link_to "All Reservation Weeks", reservation_weeks_path, class: "block text-sm text-gray-300 hover:text-white transition-colors" %>
            <%= link_to "My Profile", profile_path, class: "block text-sm text-gray-300 hover:text-white transition-colors" %>
            <% if current_user.admin? %>
              <%= link_to "Admin Dashboard", admin_root_path, class: "block text-sm text-gray-300 hover:text-white transition-colors" %>
            <% end %>
          </nav>
        </div>
      <% else %>
        <div class="space-y-4">
          <h4 class="text-lg font-semibold">Get Started</h4>
          <nav class="space-y-2">
            <%= link_to "Sign In", new_user_session_path, class: "block text-sm text-gray-300 hover:text-white transition-colors" %>
            <span class="block text-sm text-gray-400">Become a member today!</span>
          </nav>
        </div>
      <% end %>

      <!-- Contact & Legal -->
      <div class="space-y-4">
        <h4 class="text-lg font-semibold">Contact & Info</h4>
        <div class="space-y-2 text-sm text-gray-300">
          <div class="flex items-center space-x-2">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            <%= link_to "brettl.hupfers@gmail.com", contact_path, class: "hover:text-white transition-colors" %>
          </div>
          <div class="flex items-center space-x-2">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            <span>(603) 374-9242</span>
          </div>
          <div class="flex items-start space-x-2">
            <svg class="w-4 h-4 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <div>
              <div>1 George Street</div>
              <div>Bartlett Village, NH</div>
            </div>
          </div>
        </div>
        
        <!-- Legal Links -->
        <!-- 
        <div class="pt-2 space-y-1">
          <a href="#" class="block text-xs text-gray-400 hover:text-gray-300 transition-colors">Privacy Policy</a>
          <a href="#" class="block text-xs text-gray-400 hover:text-gray-300 transition-colors">Terms of Service</a>
          <a href="#" class="block text-xs text-gray-400 hover:text-gray-300 transition-colors">Club Rules & Regulations</a>
        </div>
        -->
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-gray-800">
    <div class="container mx-auto px-6 py-4">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between">
        <div class="text-sm text-gray-400">
          <p>&copy; <%= Date.current.year %> Brettl-Hupfers Ski Club. All rights reserved.</p>
        </div>
        <div class="mt-2 md:mt-0 text-sm text-gray-400">
          <p>Crafted with ❄️ for the ski community</p>
        </div>
      </div>
    </div>
  </div>
</footer>
